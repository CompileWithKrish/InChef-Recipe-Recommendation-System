# ==============================================================================
# InChef — Environment Variables Template (.env.example)
# Copy this file to .env and configure for your local environment
# ==============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inchef_db
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here
SPRING_PROFILES_ACTIVE=mysql

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length_here_replace_me
JWT_EXPIRATION_MS=86400000

# Security Lockout Settings
AUTH_LOCKOUT_MINUTES=15
AUTH_MAX_FAILED_ATTEMPTS=5

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Admin Secret
INCHEF_ADMIN_SECRET=your_admin_secret_key_here

# Dataset Path (Path to IndianFoodDatasetXLS.xlsx)
INCHEF_DATASET_PATH=data/samples/sample_recipes.xlsx

# Image Search Provider (Optional Strategy C)
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
