# ==============================================================================
# InChef — .gitignore
# Intelligent Indian Recipe Recommendation System
# ==============================================================================

# Java & Maven Build Output
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
.tools/

# Local Environment & Secrets
.env
.env.*
!.env.example
application-local.properties
application-secret.properties

# IDE & Editor Configuration
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.factorypath
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

# Logs & Temporary Files
*.log
logs/
tmp/
temp/

# Database Dumps & Backups
*.sql
*.sql.gz
*.dump
*.bak
data/backup/
!data/migrations/*.sql
!src/main/resources/**/*.sql

# Local Caches & Generated Datasets
data/cache/
data/raw/
data/cleaned/
cache/
recipe-image-cache/

# Python Virtual Environments & Cache
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# Local Scratch Directory
scratch/

